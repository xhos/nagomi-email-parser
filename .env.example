# required
API_KEY=
NAGOMI_CORE_URL=http://localhost:55555
DOMAIN=mail.example.com

# optional
SMTP_PORT=127.0.0.1:2525
GRPC_PORT=127.0.0.1:55557                   # health checks
TLS_CERT=                                   # with TLS_KEY set, TLS becomes required
TLS_KEY=
LOG_LEVEL=info                              # debug, info, warn, error
LOG_FORMAT=text                             # text or json

# debugging
# UNSAFE_DISABLE_TLS_REQUIRED=true          # also accept plaintext when certs are set
# UNSAFE_SAVE_EML=true                      # save incoming mail to emails/

# get-certs.sh
CLOUDFLARE_API_TOKEN=
LETSENCRYPT_EMAIL=
